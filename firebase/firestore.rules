rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function isAdmin(){return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;}
  function isActiveUser(){return signedIn() && (!exists(/databases/$(database)/documents/users/$(request.auth.uid)) || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('disabled', false) != true && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('forceLogout', false) != true));}
  function isChatMember(chatId){return isActiveUser() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;}
  match /admins/{uid}{allow read:if signedIn() && (request.auth.uid==uid || isAdmin());allow write:false;}
  match /users/{uid}{
   allow read:if isAdmin() || (signedIn() && request.auth.uid==uid);
   allow create:if isAdmin() || (isActiveUser() && request.auth.uid==uid && request.resource.data.keys().hasOnly(['uid','displayName','email','createdAt','fcmTokens']));
   allow update:if isAdmin() || (isActiveUser() && request.auth.uid==uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid','displayName','email','createdAt','fcmTokens','lastSeen']));
   allow delete:if isAdmin();
  }
  match /publicProfiles/{uid}{
   allow read:if isActiveUser();
   allow create,update:if isAdmin() || (isActiveUser() && request.auth.uid==uid && request.resource.data.keys().hasOnly(['uid','displayName','createdAt']));
   allow delete:if isAdmin();
  }
  match /chats/{chatId}{
   allow read:if isAdmin() || (isActiveUser() && request.auth.uid in resource.data.members);
   allow create:if isActiveUser() && request.auth.uid in request.resource.data.members && request.resource.data.members is list && request.resource.data.members.size()>=2 && request.resource.data.members.size()<=100 && request.resource.data.keys().hasOnly(['members','title','isGroup','createdBy','createdAt','updatedAt','lastMessage']);
   allow update:if (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','lastMessage','updatedAt','disabled'])) || (isChatMember(chatId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage','updatedAt']));
   allow delete:if isAdmin();
   match /messages/{messageId}{
    allow read:if isAdmin() || isChatMember(chatId);
    allow create:if isChatMember(chatId) && request.resource.data.senderId==request.auth.uid && request.resource.data.keys().hasOnly(['senderId','senderName','text','attachmentUrl','createdAt']) && request.resource.data.text is string && request.resource.data.text.size()<=4000 && request.resource.data.attachmentUrl is string && (request.resource.data.attachmentUrl=='' || request.resource.data.attachmentUrl.matches('https://.*'));
    allow update,delete:if isAdmin();
   }
  }
  match /announcements/{id}{allow read:if isActiveUser();allow create,update,delete:if isAdmin();}
  match /auditLogs/{id}{allow read:if isAdmin();allow create:if isAdmin() && request.resource.data.adminUid==request.auth.uid && request.resource.data.keys().hasOnly(['action','targetUid','details','adminUid','adminEmail','createdAt']);allow update,delete:if false;}
  match /{document=**}{allow read,write:if false;}
 }
}
rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function isAdmin(){return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;}
  function isActiveUser(){return signedIn() && (!exists(/databases/$(database)/documents/users/$(request.auth.uid)) || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('disabled', false) != true && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('forceLogout', false) != true));}
  function isChatMember(chatId){return isActiveUser() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;}
  match /admins/{uid}{allow read:if signedIn() && (request.auth.uid==uid || isAdmin());allow write:false;}
  match /users/{uid}{
   allow read:if isAdmin() || (signedIn() && request.auth.uid==uid);
   allow create:if isAdmin() || (isActiveUser() && request.auth.uid==uid && request.resource.data.keys().hasOnly(['uid','displayName','email','createdAt','fcmTokens']));
   allow update:if isAdmin() || (signedIn() && request.auth.uid==uid
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid','displayName','email','createdAt','fcmTokens','lastSeen','forceLogout'])
    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['forceLogout'])
      || (resource.data.get('forceLogout', false)==true && request.resource.data.get('forceLogout', false)==false && resource.data.get('disabled', false)!=true)));
   allow delete:if isAdmin();
  }
  match /publicProfiles/{uid}{
   allow read:if isActiveUser();
   allow create,update:if isAdmin() || (isActiveUser() && request.auth.uid==uid && request.resource.data.keys().hasOnly(['uid','displayName','createdAt']));
   allow delete:if isAdmin();
  }
  match /chats/{chatId}{
   allow read:if isAdmin() || (isActiveUser() && request.auth.uid in resource.data.members);
   allow create:if isActiveUser() && request.auth.uid in request.resource.data.members && request.resource.data.members is list && request.resource.data.members.size()>=2 && request.resource.data.members.size()<=100 && request.resource.data.keys().hasOnly(['members','title','isGroup','createdBy','createdAt','updatedAt','lastMessage']);
   allow update:if (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','lastMessage','updatedAt','disabled'])) || (isChatMember(chatId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage','updatedAt']));
   allow delete:if isAdmin();
   match /messages/{messageId}{
    allow read:if isAdmin() || isChatMember(chatId);
    allow create:if isChatMember(chatId)
      && request.resource.data.senderId==request.auth.uid
      && request.resource.data.keys().hasOnly(['senderId','senderName','text','attachmentUrl','replyToId','replyToText','createdAt'])
      && request.resource.data.text is string
      && request.resource.data.text.size()<=4000
      && request.resource.data.senderName is string
      && request.resource.data.attachmentUrl is string
      && (request.resource.data.attachmentUrl=='' || request.resource.data.attachmentUrl.matches('https://.*'))
      && (!('replyToId' in request.resource.data) || request.resource.data.replyToId is string)
      && (!('replyToText' in request.resource.data) || (request.resource.data.replyToText is string && request.resource.data.replyToText.size()<=300));
    allow update:if isAdmin() || (isChatMember(chatId)
      && resource.data.senderId==request.auth.uid
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','editedAt'])
      && request.resource.data.text is string
      && request.resource.data.text.size()>0
      && request.resource.data.text.size()<=4000);
    allow delete:if isAdmin() || (isChatMember(chatId) && resource.data.senderId==request.auth.uid);
   }
  }

  match /channels/{channelId}{
   allow read:if isAdmin() || (isActiveUser() && (resource.data.visibility=='public' || request.auth.uid in resource.data.members));
   allow create:if isActiveUser() && request.resource.data.ownerUid==request.auth.uid
     && request.resource.data.keys().hasOnly(['name','description','ownerUid','admins','members','visibility','createdAt','updatedAt']);
   allow update:if isAdmin() || (isActiveUser() && resource.data.ownerUid==request.auth.uid
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','description','admins','members','visibility','updatedAt']));
   allow delete:if isAdmin() || (isActiveUser() && resource.data.ownerUid==request.auth.uid);
   match /posts/{postId}{
    allow read:if isAdmin() || (isActiveUser() && get(/databases/$(database)/documents/channels/$(channelId)).data.visibility=='public')
      || (isActiveUser() && request.auth.uid in get(/databases/$(database)/documents/channels/$(channelId)).data.members);
    allow create:if isActiveUser()
      && (get(/databases/$(database)/documents/channels/$(channelId)).data.ownerUid==request.auth.uid
        || request.auth.uid in get(/databases/$(database)/documents/channels/$(channelId)).data.admins)
      && request.resource.data.authorUid==request.auth.uid
      && request.resource.data.keys().hasOnly(['authorUid','text','attachmentUrl','createdAt'])
      && request.resource.data.text is string && request.resource.data.text.size()<=4000
      && request.resource.data.attachmentUrl is string
      && (request.resource.data.attachmentUrl=='' || request.resource.data.attachmentUrl.matches('https://.*'));
    allow update,delete:if isAdmin() || (isActiveUser() && resource.data.authorUid==request.auth.uid);
   }
  }
  match /announcements/{id}{allow read:if isActiveUser();allow create,update,delete:if isAdmin();}
  match /auditLogs/{id}{allow read:if isAdmin();allow create:if isAdmin() && request.resource.data.adminUid==request.auth.uid && request.resource.data.keys().hasOnly(['action','targetUid','details','adminUid','adminEmail','createdAt']);allow update,delete:if false;}
  match /{document=**}{allow read,write:if false;}
 }
}